# ──────────────────────────────────────────────────────────────
# Dockerfile.playwright
# Runs Playwright E2E tests against a deployed instance of the app.
# Usage:
#   docker build -f Dockerfile.playwright -t playwright-tests .
#   docker run --rm -e BASE_URL=http://login-page-service.sopra-hr.svc.cluster.local \
#     playwright-tests
# ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/playwright:v1.52.0-jammy

WORKDIR /tests

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy package files and install dependencies
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

# Install Playwright (only chromium for faster builds)
COPY playwright.config.ts ./
RUN npx playwright install --with-deps chromium

# Copy test files
COPY e2e/ ./e2e/

# Copy entrypoint script
COPY scripts/run-e2e.sh ./run-e2e.sh
RUN chmod +x ./run-e2e.sh

# Default BASE_URL — overridden at runtime for GKE
ENV BASE_URL=http://localhost:8080
ENV CI=true

# Run tests via entrypoint that waits for the service
CMD ["./run-e2e.sh"]

